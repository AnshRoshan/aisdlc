---
import Base from "../layouts/Base.astro";
import { base } from "../lib/base.js";
import { getSkills, skillSlug, shortDesc } from "../lib/skills";

const ORDER = ["any", "discover", "specify", "plan", "tasks", "build", "verify", "accept", "release"];
const skills = getSkills();
const stages = [...new Set(skills.map((s) => s.stage))].sort((a, b) => ORDER.indexOf(a) - ORDER.indexOf(b));
const link = (href) => `${base}${href}`;
---
<Base title="Skills" description="All 20 aisdlc skills: one folder each, plain Markdown, read the same way by every coding agent.">
  <div class="wrap doc">
    <nav class="doc-rail" aria-label="Skill stages">
      {stages.map((s) => <a href={`#${s}`}>{s === "any" ? "cross-cutting" : s}</a>)}
    </nav>
    <article class="doc-body">
      <h1>Every stage has one skill. Every skill is one file.</h1>
      <p class="lede">
        Each skill is a <code>SKILL.md</code> in the open Agent Skills format, read identically by Claude Code,
        Codex, Cursor, Gemini CLI, Copilot, Windsurf and OpenCode. The CLI is the referee that derives state and
        enforces the gates. The skills are the behaviour, and they still work without it.
      </p>

      {stages.map((stage) => (
        <section id={stage}>
          <h2><span class="step-n">{stage === "any" ? "cross-cutting" : `stage: ${stage}`}</span>{skills.filter((s) => s.stage === stage).length} skills</h2>
          <div class="panel" style="padding:0.4rem 1.25rem;">
            <table class="data">
              <tbody>
                {skills.filter((s) => s.stage === stage).map((s) => (
                  <tr>
                    <td><a href={link(`/skills/${skillSlug(s.name)}`)}>{s.name}</a></td>
                    <td>{shortDesc(s.description)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </article>
  </div>
</Base>
