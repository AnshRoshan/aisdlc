---
import Base from "../../layouts/Base.astro";
import { base } from "../../lib/base.js";
import { getSkills, skillSlug } from "../../lib/skills";

export function getStaticPaths() {
  return getSkills().map((s) => ({ params: { slug: skillSlug(s.name) }, props: { skill: s } }));
}

const { skill } = Astro.props;
const rest = skill.description.split(/(?<=\.)\s/).slice(1).join(" ");
---
<Base title={`/${skill.name}`} description={skill.description.slice(0, 150)}>
  <article class="wrap" style="padding-top:3.5rem;max-width:50rem;">
    <p class="hashline"><a href={`${base}/skills`}>← all skills</a></p>
    <h1 style="font-family:var(--mono);font-size:clamp(1.5rem,4vw,2.2rem);font-weight:500;margin-top:1rem;">{skill.name}</h1>
    <p class="hashline" style="margin-top:0.5rem;">stage: <b>{skill.stage}</b> · source: <b>skills/{skill.name}/SKILL.md</b></p>
    <p class="lede" style="margin-top:1.8rem;font-size:1.05rem;">{skill.description}</p>
    {rest && <p class="lede">{rest}</p>}

    <div class="panel" style="margin-top:2.5rem;padding:1.6rem 1.6rem;">
      <h2 style="font-size:1.05rem;font-weight:600;">Install everything, or just this one</h2>
      <div class="cmdline" style="margin-top:1.1rem;"><code>npx aisdlc init</code><button data-copy="c1">copy</button></div>
      <div class="cmdline" style="margin-top:0.7rem;"><code>npx skills add AnshRoshan/aisdlc --skill {skill.name}</code><button data-copy="c2">copy</button></div>
      <p class="hashline" style="margin-top:1rem;">Claude Code: <b>/plugin marketplace add AnshRoshan/aisdlc</b>, then <b>/plugin install aisdlc@aisdlc</b>. Skills work without the CLI; the CLI is what makes “done” mean something.</p>
    </div>
  </article>
  <script>
    document.querySelectorAll("button[data-copy]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const el = btn.closest("div").querySelector("code");
        if (el) navigator.clipboard.writeText(el.textContent.replace(/^ \$ /, "").trim());
        const t = btn.textContent;
        btn.textContent = "copied ✓";
        setTimeout(() => (btn.textContent = t), 1400);
      });
    });
  </script>
</Base>
