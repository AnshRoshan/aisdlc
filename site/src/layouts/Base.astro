---
import "../styles/global.css";
import { base } from "../lib/base.js";
const { title, description = "Agents write code. aisdlc runs the process. EARS specs, six evidence gates, hash-bound approvals — local-first, any harness." } = Astro.props;
const REPO = "https://github.com/AnshRoshan/aisdlc";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? `${title} · aisdlc` : "aisdlc — agents write code, aisdlc runs the process"}</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href={`${base}/`} class="brand">aisdlc</a>
        <div class="nav-links">
          <a href={`${base}/skills`}>Skills</a>
          <a href={`${base}/docs`}>Docs</a>
          <a href={`${base}/#faq`}>FAQ</a>
          <a href={REPO} class="nav-cta">star on github ↗</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>MIT licensed · <a href={REPO}>AnshRoshan/aisdlc</a> · every claim on this page is a file check, not a vibe</p>
    </footer>
  </body>
</html>
